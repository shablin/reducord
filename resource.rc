#include <windows.h>
#include "src/version.h"

101     ICON    "assets/icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_RC
 PRODUCTVERSION APP_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Reducord Authors"
            VALUE "FileDescription", "Lightweight Discord cleanup utility"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "InternalName", "Reducord"
            VALUE "LegalCopyright", "Copyright (C) 2026 Maxim Shablin & KCJ"
            VALUE "OriginalFilename", "Reducord"
            VALUE "ProductName", "Reducord"
            VALUE "ProductVersion", APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END